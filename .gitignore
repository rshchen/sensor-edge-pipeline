# ==========================================
# Operating System Files
# ==========================================
# macOS 系統快取與縮圖
.DS_Store
.AppleDouble
.LSOverride
Icon_
._*

# Windows 系統快取
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# IDE / Editor Files
# ==========================================
# VS Code 配置與快取
.vscode/
.history/
*.code-workspace

# JetBrains / PyCharm
.idea/

# ==========================================
# Python / uv Environment & Cache
# ==========================================
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
dist/
*.egg-info/

# ==========================================
# C++ / CMake Build Artifacts
# ==========================================
# 匹配根目錄與所有子目錄（如 cpp/build/）
**/build/
bin/
lib/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# 編譯中繼目標檔與二進位執行檔
*.o
*.obj
*.exe
sensor_infer

# ==========================================
# Third-Party Prebuilt Libraries
# ==========================================
# 排除大型預編譯動態庫
cpp/third_party/onnxruntime/lib/
*.dylib
*.so
*.dll

# ==========================================
# Datasets & Large Models
# ==========================================
# 大型本機資料集
data/

# 二進位模型檔案與分離權重（僅保留目錄結構）
models/*.onnx
models/*.onnx.data
models/*.pt
models/*.bin
!models/.gitkeep

